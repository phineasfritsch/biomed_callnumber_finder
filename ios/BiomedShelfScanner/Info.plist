<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hand-written, so it must carry the keys Xcode would otherwise synthesise with
  GENERATE_INFOPLIST_FILE. Omitting CFBundleIdentifier produces a bundle the simulator refuses to
  install with "Missing bundle ID" (IXErrorDomain 13) — the build itself succeeds, so the error
  surfaces only at install time.

  The $(...) values are expanded by the Process Info.plist build phase from the target settings.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<!-- Upload validation (error 90713) requires this key whenever icons come from an asset
	     catalog. Xcode injects it automatically for GENERATED plists only — a hand-written one
	     must carry it itself. Must match ASSETCATALOG_COMPILER_APPICON_NAME in project.yml. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Shelf Scanner</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Shown in the permission prompt. Specific about what the camera is for (5.1.1 requires
	     accuracy, and a vague string is how people tap Deny).

	     Deliberately does NOT claim "no photos are ever saved": the opt-in Scan Diagnostics
	     feature keeps frames of failed reads on-device and lets the user export them. A purpose
	     string that overpromises is a guideline violation the moment a reviewer opens that
	     screen. -->
	<key>NSCameraUsageDescription</key>
	<string>The camera reads call numbers from book spine labels and request sheets so they can be located in the stacks. Recognition runs entirely on this device.</string>

	<!-- The only network traffic is HTTPS to the headcount submit proxy, which is exempt
	     encryption (standard TLS, no proprietary or non-standard cryptography of our own).
	     Declaring it here skips the export-compliance questionnaire on every TestFlight upload.
	     Scanning and routing remain entirely on-device and work with the radio off. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Bundled so the app looks like itself in a basement with no signal, which is where it is
	     used. Static instances built by ios/Tools/make-fonts.py — see Theme.FontName for why the
	     variable originals are not shipped directly (Fraunces' variable default is Black at 9pt
	     optical size, which is not the face Shelfmark uses anywhere).

	     Every filename here must exist in Resources/Fonts or the font silently falls back to the
	     system face at runtime; ios/Tools/fonts.test.js asserts the two lists match. -->
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces-Regular.ttf</string>
		<string>Fraunces-Medium.ttf</string>
		<string>Fraunces-SemiBold.ttf</string>
		<string>SplineSansMono-Regular.ttf</string>
		<string>SplineSansMono-Medium.ttf</string>
		<string>SplineSansMono-SemiBold.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>

	<!-- Portrait only: a one-handed tool used while pushing a cart. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  No UIRequiredDeviceCapabilities.

	  The previous version declared "armv7" (wrong — this is a 64-bit-only app; armv7 is 32-bit ARM,
	  which no supported device runs) and "video-camera". The camera requirement also contradicted
	  the app's own behaviour: ScanView has a deliberate no-camera fallback so routing and manual
	  entry still work, and declaring the camera mandatory would have blocked install on exactly
	  the configurations that fallback exists for — including the Simulator.
	-->
</dict>
</plist>
