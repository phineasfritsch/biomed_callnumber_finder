<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Shelf Scanner</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Shown in the permission prompt. Says what the camera is for and that nothing leaves the
	     device, because "this app wants camera access" with no reason is how people tap Deny. -->
	<key>NSCameraUsageDescription</key>
	<string>Scans call numbers from book spines and request sheets. Everything is read on this device — no photos are saved or sent anywhere.</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>

	<!-- Portrait only: a one-handed tool used while pushing a cart. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
		<string>video-camera</string>
	</array>
</dict>
</plist>
